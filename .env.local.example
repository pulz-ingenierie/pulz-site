# ============================================================
#  Variables d'environnement PULZ — à remplir avec TES clés
#  Copie ce fichier en ".env.local" et remplis les valeurs.
#  NE JAMAIS commiter .env.local sur GitHub (déjà dans .gitignore)
# ============================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # secret ! (côté serveur uniquement)

# --- Anthropic (pour les fonctions IA : renommage photos, SEO) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend (envoi des emails du formulaire de contact) ---
RESEND_API_KEY=re_...
CONTACT_FROM_EMAIL=site@pulz-ingenierie.fr
